AMAZON_HEADERS_JSON=
AMAZON_COOKIES_JSON=

# PostgreSQL connection used by explicitly invoked database workflows.
# Example only; keep real credentials in an uncommitted local environment.
DATABASE_URL=<postgresql-connection-url>
TEST_DATABASE_URL=<disposable-postgresql-test-connection-url>

# Conservative limits for the live Apple-to-PostgreSQL test. The implementation
# also enforces hard upper bounds and creates a unique run name by default.
APPLE_LIVE_APP_ID=544007664
APPLE_LIVE_APP_NAME=YouTube
APPLE_LIVE_COUNTRY=us
APPLE_LIVE_LANGUAGE=en
APPLE_LIVE_CATEGORY=video
APPLE_LIVE_PASSES=2
APPLE_LIVE_MAX_PAGES_PER_PASS=1
APPLE_LIVE_MAX_REQUESTS=2
APPLE_LIVE_MAX_NORMALIZED_REVIEWS=25
APPLE_LIVE_REQUEST_DELAY_SECONDS=1.5
APPLE_LIVE_REQUEST_TIMEOUT_SECONDS=20
